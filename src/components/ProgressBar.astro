---
interface Props {
  roadmapId: string;
  topicCount: number;
}

const { roadmapId, topicCount } = Astro.props;
---

<div class="progress-bar-container">
  <div class="container">
    <div class="progress-bar-inner">
      <div class="progress-bar-track">
        <div class="progress-bar-fill" id="progress-fill" style="width: 0%"></div>
      </div>
      <span class="progress-bar-label" id="progress-label">0%</span>
    </div>
  </div>
</div>
