---
interface Props {
  sections: any[];
  roadmapId: string;
  estimatedTime?: string;
}

const { sections, roadmapId, estimatedTime = '16 weeks' } = Astro.props;

const totalWeeks = parseInt(estimatedTime, 10) || 16;
const weeksPerSection = Math.max(1, Math.round(totalWeeks / Math.max(1, sections.length)));

function getWeekLabel(section: any, index: number) {
  if (section.weekLabel) return section.weekLabel;
  const startWeek = index * weeksPerSection + 1;
  const endWeek = (index + 1) * weeksPerSection;
  return `Weeks ${startWeek}–${endWeek}`;
}
---

<div class="roadmap-tree" id="tree-view">
  {sections.map((section, i) => {
    const weekText = getWeekLabel(section, i);
    return (
      <div class="tree-section" id={`section-${i}`}>
        <div class="tree-section-header">
          <div class="tree-section-header-left">
            <span class="tree-section-number">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="tree-section-title">{section.title}</h2>
          </div>
          <span class="week-tag badge-mono">{weekText}</span>
        </div>

        <div class="tree-topics">
          {section.topics.map((topic: any, topicIdx: number) => (
            <div class="tree-node" data-topic-id={topic.id} id={`topic-${topic.id}`}>
              <div class="tree-node-content">
                <div class="tree-node-header">
                  <div class="checkbox-wrapper">
                    <input
                      type="checkbox"
                      class="tree-node-check"
                      data-roadmap={roadmapId}
                      data-topic={topic.id}
                      aria-label={`Mark ${topic.title} as complete`}
                    />
                    {i === 0 && topicIdx === 0 && (
                      <div class="checkbox-onboarding-tooltip" id="checkbox-onboarding-tooltip" role="tooltip">
                        <div class="tooltip-content">
                          <span class="tooltip-sparkle">💡</span>
                          <div class="tooltip-text">
                            <strong>Track Progress:</strong> Check items as you complete them to save your progress!
                          </div>
                          <button type="button" class="tooltip-close-btn" id="dismiss-checkbox-tooltip" aria-label="Dismiss tooltip">
                            Got it!
                          </button>
                        </div>
                        <div class="tooltip-arrow"></div>
                      </div>
                    )}
                  </div>
                  <span class="tree-node-title">{topic.title}</span>
                </div>

                {topic.description && <p class="tree-node-desc">{topic.description}</p>}

                {/* Interactive Subtopic Dropdowns */}
                {topic.subtopics && topic.subtopics.length > 0 && (
                  <div class="tree-subtopics-container">
                    {topic.subtopics.map((sub: any, subIndex: number) => {
                      const subTitle = typeof sub === 'string' ? sub : sub.title;
                      const subDesc = typeof sub === 'string' ? null : sub.description;
                      const subResources = typeof sub === 'string' ? null : sub.resources;
                      const dayTag = (typeof sub === 'object' && sub.dayLabel) ? sub.dayLabel : `Days ${subIndex * 2 + 1}–${subIndex * 2 + 2}`;

                      return (
                        <details class="subtopic-accordion">
                          <summary class="subtopic-summary">
                            <div class="subtopic-summary-left">
                              <svg class="subtopic-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"></polyline>
                              </svg>
                              <span class="subtopic-title">{subTitle}</span>
                            </div>
                            <span class="day-tag badge-mono">{dayTag}</span>
                          </summary>
                          <div class="subtopic-details-body">
                            <div class="subtopic-info-box">
                              <span class="subtopic-info-label">💡 What to Learn:</span>
                              <p class="subtopic-info">
                                {subDesc || `In-depth learning milestone for ${subTitle}. Understand core principles, common use cases, underlying implementation details, hands-on syntax, and production best practices.`}
                              </p>
                            </div>
                            {subResources && subResources.length > 0 && (
                              <div class="tree-resources" style="padding-left: 0; margin-top: 10px;">
                                <span class="resources-label">Resources:</span>
                                {subResources.map((res: any) => (
                                  <a
                                    class="tree-resource-link"
                                    href={res.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                  >
                                    <span class="tree-resource-icon">
                                      {res.type === 'video' ? '▶' : res.type === 'course' ? '🎓' : res.type === 'project' ? '🔧' : res.type === 'docs' ? '📖' : '📄'}
                                    </span>
                                    {res.title}
                                  </a>
                                ))}
                              </div>
                            )}
                          </div>
                        </details>
                      );
                    })}
                  </div>
                )}

                {/* Topic-level resources */}
                {topic.resources && topic.resources.length > 0 && (
                  <div class="tree-resources">
                    {topic.resources.map((res: any) => (
                      <a
                        class="tree-resource-link"
                        href={res.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span class="tree-resource-icon">
                          {res.type === 'video' ? '▶' : res.type === 'course' ? '🎓' : res.type === 'project' ? '🔧' : res.type === 'docs' ? '📖' : '📄'}
                        </span>
                        {res.title}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}

          {section.projects && section.projects.length > 0 && (
            <div class="mini-projects-wrapper" style="margin-top: 16px;">
              {section.projects.map((proj: any) => (
                <div class="mini-project-card" data-project-id={proj.id}>
                  <div class="mini-project-header">
                    <span style="font-size: 16px;">🛠️</span>
                    <h3 class="mini-project-title">{proj.title}</h3>
                    <span class="mini-project-badge">Mini-Project</span>
                  </div>
                  <p class="mini-project-desc">{proj.description}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    );
  })}
</div>
