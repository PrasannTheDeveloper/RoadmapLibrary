<section
  class="relative hidden h-[700px] overflow-hidden bg-[#e3e6ef] lg:block"
>
  <!-- RIGHT IMAGE — FULL IMAGE, NO CROPPING -->
  <img
    src="/Hero/HeroRightImage.png"
    alt="Interactive Developer Roadmap Illustration"
    loading="eager"
    decoding="async"
    class="absolute right-15 top-0 z-0 h-full w-auto max-w-none max-h-full object-contain object-right"
  />

  <!-- CONTENT -->
  <div
    class="relative z-10 mx-auto flex h-full max-w-[1600px] items-center px-16 py-16 xl:px-50"
  >
    <div class="animate-fade-in-up max-w-3xl">

      <span
        class="mb-4 inline-block rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas-soft-2)] px-4 py-2 text-sm font-medium"
      >
        ⚡ Interactive Learning Paths
      </span>

      <h1 class="text-display-xl m-0 mb-5">
        Master any tech skill with an
        <span class="text-gradient-vibrant">
          interactive developer roadmap.
        </span>
      </h1>

      <p
        class="text-body-lg mb-8 max-w-2xl leading-[30px]"
        style="color: var(--color-body);"
      >
        Bookmark this site and track your interactive developer roadmap
        directly online. Check off topics, complete hands-on mini-projects,
        and resume your learning anytime — eliminating the need for
        cluttering static PDFs or lost file downloads.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a href="#roadmaps" class="btn-primary">
          Explore Interactive Roadmaps
        </a>

        <span
          class="text-caption-mono rounded-full border px-3 py-2"
          style="
            color: var(--color-mute);
            background: var(--color-canvas-soft-2);
            border-color: var(--color-hairline);
          "
        >
          📌 Tip: Press Cmd/Ctrl + D to Bookmark
        </span>
      </div>

      <div
        class="mt-6 flex flex-wrap items-center gap-2.5 border-t pt-5"
        style="border-color: var(--color-hairline);"
      >
        <span
          class="text-caption-mono mr-1"
          style="color: var(--color-mute);"
        >
          Quick Links:
        </span>

        <a href="/privacy" class="hero-quick-link">
          🔒 Privacy Policy
        </a>

        <a href="/terms" class="hero-quick-link">
          📜 Terms & Conditions
        </a>

        <a href="/about" class="hero-quick-link">
          ℹ️ About Us
        </a>

        <a href="/contact" class="hero-quick-link">
          📩 Contact Us
        </a>
      </div>

    </div>
  </div>
</section>




