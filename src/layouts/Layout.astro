---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Developer Roadmap Library — Step-by-Step Interactive Coding Roadmaps (2026)',
  description = 'Explore interactive developer roadmaps for 2026. Step-by-step learning paths for AI engineer roadmap, full stack developer roadmap, DevOps roadmap, roadmap Python, roadmap Java, roadmap JavaScript, and roadmap backend framework engineering.',
  image = '/web-app-manifest-512x512.png',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://roadmaplibrary.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL(image, siteUrl);

const keywords = [
  'developer roadmap',
  'ai engineer roadmap',
  'ai engineer roadmap 2026',
  'devops roadmap',
  'cybersecurity roadmap',
  'roadmap ai',
  'roadmap python',
  'roadmap java',
  'roadmap javascript',
  'roadmap backend',
  'roadmap developer',
  'full stack developer roadmap',
  'web developer roadmap',
  'coding roadmap',
].join(', ');

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Roadmap Library',
  alternateName: ['Developer Roadmap Library', 'RoadmapLibrary'],
  url: siteUrl,
  description: description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/#roadmap-search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZX3G4HN435"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-ZX3G4HN435');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Roadmap Library" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Developer Roadmap Library — Interactive Coding Paths" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="RoadmapLibrary" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- JSON-LD Structured Data for SEO -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>

    <!-- Geist Fonts -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/style.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-mono/style.min.css" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>